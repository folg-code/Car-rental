# Skopiuj do .env (dev), .env.local (lokalne nadpisania) lub .env.production (serwer).
# Nigdy nie commituj prawdziwych haseł.

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

SECRET_KEY=change-me-to-a-long-random-string

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Bramka płatności (Sprint 9) — mock domyślnie w dev
PAYMENT_GATEWAY_PROVIDER=mock
PAYMENT_GATEWAY_MOCK_BASE_URL=http://localhost:8000
PAYMENT_GATEWAY_WEBHOOK_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SIGNATURE_HEADER=X-Payment-Signature

# Celery (Sprint 9.7) — w Docker: host `redis`
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Chat AI (Sprint 8b)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024
CHAT_RATE_LIMIT_PER_HOUR=30
CHAT_MESSAGE_RETENTION_DAYS=90

# Produkcja (Sprint 9.9) — ustaw w .env.production na VPS
# DEBUG=False
# ALLOWED_HOSTS=twoja-domena.pl,www.twoja-domena.pl
# CSRF_TRUSTED_ORIGINS=https://twoja-domena.pl,https://www.twoja-domena.pl
# DOMAIN=twoja-domena.pl
# ACME_EMAIL=admin@twoja-domena.pl
# SECURE_SSL_REDIRECT=True
# DEFAULT_FROM_EMAIL=noreply@twoja-domena.pl
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# BACKUP_DIR=/opt/car-rental/backups
# BACKUP_RETENTION_DAYS=14
