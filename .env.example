# Skopiuj do .env (dev), .env.local (lokalne nadpisania) lub .env.production (serwer).
# Szablon demo prod: .env.production.example (Sprint 10)
# Nigdy nie commituj prawdziwych haseł.

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

SECRET_KEY=change-me-to-a-long-random-string

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Uploady (flota, protokoly) — max rozmiar pliku w bajtach (domyslnie 10 MB)
# UPLOAD_MAX_BYTES=10485760

# Bramka płatności (Sprint 9) — mock domyślnie w dev
PAYMENT_GATEWAY_PROVIDER=mock
PAYMENT_GATEWAY_MOCK_BASE_URL=http://localhost:8000
PAYMENT_GATEWAY_WEBHOOK_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SIGNATURE_HEADER=X-Payment-Signature

# Celery (Sprint 9.7) — w Docker: host `redis`
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
RESERVATION_PENDING_PAYMENT_TTL_HOURS=48

# Chat AI (Sprint 8b)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024
CHAT_RATE_LIMIT_PER_HOUR=30
CHAT_MESSAGE_RETENTION_DAYS=90
CHAT_DEFAULT_PICKUP_HOUR=10
CHAT_DEFAULT_RETURN_HOUR=10

# Email — dev: console (logi kontenera web/celery). Prod: SMTP.
PUBLIC_SITE_BASE_URL=http://localhost:8000
DEFAULT_FROM_EMAIL=noreply@car-rental.local
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Aby wysylac maile (Gmail, SendGrid itd.) odkomentuj SMTP i ustaw ponizsze wartosci:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-smtp-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# SMS — domyslnie wylaczone w dev; mock gdy wlaczone
# SMS_ENABLED=True
# SMS_PROVIDER=mock
# SMS_FROM_NUMBER=+48123456789
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Produkcja demo (Sprint 10) — pelny szablon: .env.production.example
# Runbook prezentacji: docs/DEMO_RUNBOOK.md
# DEBUG=False
# DEMO_SITE=True
# LOG_LEVEL=INFO
# ALLOWED_HOSTS=twoja-domena.pl,www.twoja-domena.pl
# CSRF_TRUSTED_ORIGINS=https://twoja-domena.pl,https://www.twoja-domena.pl
# DOMAIN=twoja-domena.pl
# ACME_EMAIL=admin@twoja-domena.pl
# SECURE_SSL_REDIRECT=True
# PUBLIC_SITE_BASE_URL=https://twoja-domena.pl
# PAYMENT_GATEWAY_PROVIDER=mock
# PAYMENT_GATEWAY_MOCK_BASE_URL=https://twoja-domena.pl
# DEFAULT_FROM_EMAIL=noreply@twoja-domena.pl
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# SMS_ENABLED=False
# BACKUP_DIR=/opt/car-rental/backups
# BACKUP_RETENTION_DAYS=14
