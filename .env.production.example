# Szablon .env.production — wersja DEMO PRODUKCYJNA (VPS pokazowy)
#
# Uzycie na serwerze:
#   cp .env.production.example .env.production
#   nano .env.production   # uzupelnij domenę, SECRET_KEY, hasla DB
#
# Mock platnosci i placeholder regulaminu sa ZAMIERZONE dla tej wersji.
# Szczegoly: docs/DEMO_RUNBOOK.md, docs/DEPLOY.md

# --- Django (wymagane) ---
DEBUG=False
SECRET_KEY=GENERUJ-DLUGI-LOSOWY-KLUCZ-min-50-znakow
ALLOWED_HOSTS=twoja-domena.pl,www.twoja-domena.pl
CSRF_TRUSTED_ORIGINS=https://twoja-domena.pl,https://www.twoja-domena.pl

# Baner „wersja demonstracyjna” na stronie publicznej
DEMO_SITE=True

# --- HTTPS (Caddy) ---
DOMAIN=twoja-domena.pl
ACME_EMAIL=admin@twoja-domena.pl
SECURE_SSL_REDIRECT=True

# --- PostgreSQL (docker-compose.prod: serwis db) ---
POSTGRES_DB=car_rental
POSTGRES_USER=rental
POSTGRES_PASSWORD=GENERUJ-SILNE-HASLO
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Celery + Redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Platnosci MOCK (docelowe dla demo) ---
PAYMENT_GATEWAY_PROVIDER=mock
PAYMENT_GATEWAY_MOCK_BASE_URL=https://twoja-domena.pl
PAYMENT_GATEWAY_WEBHOOK_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SIGNATURE_HEADER=X-Payment-Signature

# --- Email (demo: logi w kontenerze wystarcza) ---
PUBLIC_SITE_BASE_URL=https://twoja-domena.pl
DEFAULT_FROM_EMAIL=noreply@twoja-domena.pl
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Opcjonalnie SMTP testowy:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# --- SMS (wylaczone na demo) ---
SMS_ENABLED=False
SMS_PROVIDER=mock

# --- Chat AI (mock LLM — bez klucza OpenAI) ---
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
CHAT_RATE_LIMIT_PER_HOUR=30
CHAT_MESSAGE_RETENTION_DAYS=90

# --- Backup (scripts/backup.sh) ---
BACKUP_DIR=/opt/car-rental/backups
BACKUP_RETENTION_DAYS=14

# --- Obraz Docker (deploy z GHCR) ---
# WEB_IMAGE=ghcr.io/folg-code/car-rental:latest
