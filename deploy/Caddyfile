# Reverse proxy HTTPS (task 9.9).
# Wymaga w .env.production: DOMAIN, opcjonalnie ACME_EMAIL (Let's Encrypt).
# Uruchomienie: COMPOSE_PROFILES=https docker compose -f docker-compose.prod.yml up -d

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip

	handle_path /static/* {
		root * /srv/static
		file_server
	}

	handle_path /media/* {
		root * /srv/media
		file_server
	}

	reverse_proxy web:8000
}
