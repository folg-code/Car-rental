# LEGACY / local only — NIE jest źródłem prawdy dla publicznego TLS.
#
# Na VPS HTTPS prowadzi osobny stack: /opt/edge (Caddy na :80/:443).
# Routing domen (car-rental, dashboard, …) = /opt/edge/caddy/Caddyfile.
#
# Ten plik NIE powinien:
# - być uruchamiany w docker-compose.prod.yml,
# - publikować 80/443 na współdzielonym VPS,
# - zawierać upstreamów innych projektów (np. dashboard.filipf.online).
#
# Edge montuje wolumeny car-rental_static_data / car-rental_media_data
# oraz sieć car-rental_default (proxy do web:8000).

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip

	handle_path /static/* {
		root * /srv/static
		file_server
	}

	handle_path /media/* {
		root * /srv/media
		file_server
	}

	reverse_proxy web:8000
}
